{
  "release": "way-v70-standard-core",
  "architecture": "single-8080-router-with-dynamic-railway-topology",
  "base_nodes": 3,
  "max_nodes": 4,
  "application_port": 8080,
  "entries": {
    "443": "railway-public-xhttp-tls",
    "tcp-proxy": "raw-reality-vision + xhttp-reality",
    "cloudflare": "optional-ws-tls"
  },
  "routing": {
    "http": 10086,
    "raw_reality_sni": 10087,
    "xhttp_reality_sni": 10088,
    "cloudflare_ws": "optional"
  },
  "source_of_truth": "main",
  "cloudflare_enablement": "all six Cloudflare Variables must be valid",
  "runtime_source": "current Railway Public Networking",
  "node4_rule": "Node 04 exists only when the complete Cloudflare condition is satisfied"
}
